{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "stack-route": {
        "ClusterId": "stack-cluster",
        "Match": {
          "Path": "/stack"
        }
      }
    },
    "Clusters": {
      "stack-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "FailurePolicy": "Return503Error",
          "AffinityKeyName": "WS01.Affinity",
          "Cookie": {
            "Path": "/",
            "HttpOnly": true,
            "IsEssential": true,
            "SameSite": "Lax",
            "SecurePolicy": "SameAsRequest"
          }
        },
        "Destinations": {
          "instance-1": {
            "Address": "http://ws01-1:8080/"
          },
          "instance-2": {
            "Address": "http://ws01-2:8080/"
          }
        }
      }
    }
  }
}