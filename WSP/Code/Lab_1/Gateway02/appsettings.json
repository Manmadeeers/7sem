{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "stack-route": {
        "ClusterId": "stack-cluster",
        "Match": {
          "Path": "/stack"
        }
      }
    },
    "Clusters": {
      "stack-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": false
        },
        "Destinations": {
          "instance-1": {
            "Address": "http://ws02-1:8080/"
          },
          "instance-2": {
            "Address": "http://ws02-2:8080/"
          }
        }
      }
    }
  }
}