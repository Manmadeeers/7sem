<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools"
                      Version="2.84.0"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../Proto/calculator.proto"
              ProtoRoot="../Proto"
              Link="Proto/calculator.proto"
              GrpcServices="Client" />
  </ItemGroup>

</Project>